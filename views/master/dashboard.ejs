<%- include('../partials/head', { pageTitle: 'Dashboard' }) %>

<div class="layout-wrapper">
    <%- include('../partials/master_sidebar', { activePage: 'dashboard' }) %>

    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0"><i class="bi bi-grid-1x2-fill me-2 text-primary"></i>Dashboard</h4>
                <p class="text-muted small mb-0" style="margin-top:2px;">
                    Admission overview &nbsp;&mdash;&nbsp;
                    <%= new Date().toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %>
                </p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/master/students" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-people me-1"></i>Manage Students
                </a>
                <form action="/master/logout" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            <%- include('../partials/flash_messages') %>

            <!-- ── Stats Cards ── -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="stat-card blue">
                        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value"><%= stats.total %></div>
                            <div class="stat-label">Total Registered</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="stat-card yellow">
                        <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                        <div class="stat-info">
                            <div class="stat-value"><%= stats.pending %></div>
                            <div class="stat-label">Pending Review</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="stat-card green">
                        <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value"><%= stats.approved %></div>
                            <div class="stat-label">Approved</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="stat-card red">
                        <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value"><%= stats.rejected %></div>
                            <div class="stat-label">Rejected</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- ── Admission Progress ── -->
                <div class="col-lg-5">
                    <div class="data-card h-100">
                        <div class="data-card-header">
                            <h5><i class="bi bi-bar-chart-fill me-2"></i>Admission Progress</h5>
                        </div>
                        <div class="p-4">
                            <% if (stats.total === 0) { %>
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox" style="font-size:2.5rem; opacity:.3;"></i>
                                    <p class="mt-2 mb-0 small">No applications yet.</p>
                                </div>
                            <% } else { %>
                                <% const pct = (v) => stats.total > 0 ? Math.round((v/stats.total)*100) : 0; %>

                                <div class="progress-item mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-600 small"><i class="bi bi-hourglass-split me-2 text-warning"></i>Pending</span>
                                        <span class="small text-muted"><%= stats.pending %> / <%= stats.total %></span>
                                    </div>
                                    <div class="progress" style="height:10px; border-radius:5px; background:#fef3c7;">
                                        <div class="progress-bar" role="progressbar"
                                             style="width:<%= pct(stats.pending) %>%; background:#d97706; border-radius:5px;"
                                             aria-valuenow="<%= pct(stats.pending) %>" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="text-end small text-muted mt-1"><%= pct(stats.pending) %>%</div>
                                </div>

                                <div class="progress-item mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-600 small"><i class="bi bi-check-circle-fill me-2 text-success"></i>Approved</span>
                                        <span class="small text-muted"><%= stats.approved %> / <%= stats.total %></span>
                                    </div>
                                    <div class="progress" style="height:10px; border-radius:5px; background:#dcfce7;">
                                        <div class="progress-bar" role="progressbar"
                                             style="width:<%= pct(stats.approved) %>%; background:#16a34a; border-radius:5px;"
                                             aria-valuenow="<%= pct(stats.approved) %>" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="text-end small text-muted mt-1"><%= pct(stats.approved) %>%</div>
                                </div>

                                <div class="progress-item mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-600 small"><i class="bi bi-x-circle-fill me-2 text-danger"></i>Rejected</span>
                                        <span class="small text-muted"><%= stats.rejected %> / <%= stats.total %></span>
                                    </div>
                                    <div class="progress" style="height:10px; border-radius:5px; background:#fee2e2;">
                                        <div class="progress-bar" role="progressbar"
                                             style="width:<%= pct(stats.rejected) %>%; background:#dc2626; border-radius:5px;"
                                             aria-valuenow="<%= pct(stats.rejected) %>" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="text-end small text-muted mt-1"><%= pct(stats.rejected) %>%</div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- ── Branch Breakdown ── -->
                <div class="col-lg-7">
                    <div class="data-card h-100">
                        <div class="data-card-header">
                            <h5><i class="bi bi-diagram-3-fill me-2"></i>Applications by Branch</h5>
                        </div>
                        <div class="p-4">
                            <% if (!branchStats || branchStats.length === 0) { %>
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox" style="font-size:2.5rem; opacity:.3;"></i>
                                    <p class="mt-2 mb-0 small">No applications yet.</p>
                                </div>
                            <% } else { %>
                                <% branchStats.forEach(b => { %>
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <div style="width:48px; text-align:center; flex-shrink:0;">
                                            <span class="badge bg-primary" style="font-size:.75rem; letter-spacing:.5px; padding:.35em .7em;"><%= b._id %></span>
                                        </div>
                                        <div class="flex-1" style="flex:1;">
                                            <div class="progress" style="height:8px; border-radius:4px;">
                                                <div class="progress-bar" role="progressbar"
                                                     style="width:<%= stats.total > 0 ? Math.round((b.count/stats.total)*100) : 0 %>%; background: var(--primary-light); border-radius:4px;">
                                                </div>
                                            </div>
                                        </div>
                                        <div style="width:48px; text-align:right; flex-shrink:0;">
                                            <span class="small fw-600 text-dark"><%= b.count %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Recent Applications ── -->
            <div class="data-card">
                <div class="data-card-header">
                    <h5><i class="bi bi-clock-history me-2"></i>Recent Applications</h5>
                    <a href="/master/students" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrow-right me-1"></i>View All
                    </a>
                </div>

                <% if (recentStudents.length === 0) { %>
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox" style="font-size:3rem; opacity:.3;"></i>
                        <p class="mt-2">No students registered yet.</p>
                    </div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table data-table">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>Branch</th>
                                <th>Roll Number</th>
                                <th>Registered</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentStudents.forEach(student => { %>
                            <tr>
                                <td>
                                    <div class="fw-600 text-dark"><%= student.fullName %></div>
                                </td>
                                <td><span class="badge bg-light text-primary fw-600"><%= student.branch %></span></td>
                                <td>
                                    <% if (student.rollNumber) { %>
                                        <code class="text-success" style="font-size:.8rem;"><%= student.rollNumber %></code>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        <%= new Date(student.createdAt).toLocaleDateString('en-IN', {
                                            day:'2-digit', month:'short', year:'numeric'
                                        }) %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge-status badge-<%= student.status %>">
                                        <% if (student.status === 'pending')  { %><i class="bi bi-hourglass-split me-1"></i><% } %>
                                        <% if (student.status === 'approved') { %><i class="bi bi-check-circle me-1"></i><% } %>
                                        <% if (student.status === 'rejected') { %><i class="bi bi-x-circle me-1"></i><% } %>
                                        <%= student.status %>
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap align-items-center">
                                        <a href="/master/student/<%= student._id %>" class="btn-action btn-view" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>

                                        <% if (student.status === 'pending') { %>
                                        <button type="button" class="btn-action btn-approve"
                                                onclick="openApproveModal('<%= student._id %>', '<%= student.fullName %>', '<%= student.branch %>', '<%= student.email || '' %>')"
                                                title="Approve Application">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                        <button type="button" class="btn-action btn-reject"
                                                onclick="openRejectModal('<%= student._id %>', '<%= student.fullName %>')"
                                                title="Reject Application">
                                            <i class="bi bi-x-lg"></i> Reject
                                        </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>

        </div><!-- /page-content -->

        <%- include('../partials/footer') %>
    </div>
</div>

<!-- ── Approve Modal ── -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-check-circle-fill me-2"></i>Approve Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="approveForm" method="POST" onsubmit="handleApproveSubmit(this)">
                <input type="hidden" name="returnUrl" value="/master/dashboard">
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">
                        Approve admission application for <strong id="approveStudentName" class="text-dark"></strong>?
                    </p>
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">Branch:</span>
                            <span class="fw-600 text-dark" id="approveStudentBranch"></span>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Student Email:</span>
                            <span class="fw-600 text-dark" id="approveStudentEmail"></span>
                        </div>
                    </div>
                    <div class="alert alert-info py-2 px-3 small mb-0 d-flex gap-2 align-items-center">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span>A unique Roll Number will be generated and login credentials will be emailed to the student.</span>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="confirmApproveBtn" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i> Confirm &amp; Approve
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Reject Modal ── -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Reject Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectForm" method="POST">
                <input type="hidden" name="returnUrl" value="/master/dashboard">
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">Rejecting: <strong id="rejectStudentName" class="text-dark"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-600 small" for="rejectionReason">Reason for Rejection</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason"
                                  rows="4" placeholder="Provide a reason..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i> Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openApproveModal(id, name, branch, email) {
    document.getElementById('approveForm').action = '/master/student/' + id + '/approve';
    document.getElementById('approveStudentName').textContent = name;
    document.getElementById('approveStudentBranch').textContent = branch || '—';
    document.getElementById('approveStudentEmail').textContent = email || '—';
    new bootstrap.Modal(document.getElementById('approveModal')).show();
}

function handleApproveSubmit(form) {
    const btn = document.getElementById('confirmApproveBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Approving...';
}

function openRejectModal(id, name) {
    document.getElementById('rejectForm').action = '/master/student/' + id + '/reject';
    document.getElementById('rejectStudentName').textContent = name;
    new bootstrap.Modal(document.getElementById('rejectModal')).show();
}
</script>
