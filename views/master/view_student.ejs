<%- include('../partials/head', { pageTitle: student.fullName + ' — Student Details' }) %>

<div class="layout-wrapper">
    <%- include('../partials/master_sidebar', { activePage: 'students' }) %>

    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar d-flex align-items-center gap-3">
            <a href="/master/students" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Students
            </a>
            <h4 class="mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Student Details</h4>
        </div>

        <div class="page-content">
            <%- include('../partials/flash_messages') %>

            <!-- Student Name + Status Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="mb-0" style="color:var(--primary);"><%= student.fullName %></h2>
                    <span class="text-muted small">
                        Registered on <%= new Date(student.createdAt).toLocaleDateString('en-IN', {
                            day:'2-digit', month:'long', year:'numeric'
                        }) %>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-status badge-<%= student.status %> fs-6 px-3 py-2">
                        <% if (student.status === 'pending') { %><i class="bi bi-hourglass-split me-1"></i><% } %>
                        <% if (student.status === 'approved') { %><i class="bi bi-check-circle me-1"></i><% } %>
                        <% if (student.status === 'rejected') { %><i class="bi bi-x-circle me-1"></i><% } %>
                        <%= student.status.toUpperCase() %>
                    </span>

                    <% if (student.status === 'pending') { %>
                    <button type="button" class="btn btn-success btn-sm"
                            onclick="openApproveModal('<%= student._id %>', '<%= student.fullName %>', '<%= student.branch %>', '<%= student.email || '' %>')">
                        <i class="bi bi-check-lg me-1"></i> Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm"
                            onclick="openRejectModal('<%= student._id %>', '<%= student.fullName %>')">
                        <i class="bi bi-x-lg me-1"></i> Reject
                    </button>
                    <% } %>
                </div>
            </div>

            <% if (student.status === 'rejected' && student.rejectionReason) { %>
            <div class="alert alert-danger d-flex gap-2 align-items-start mb-4">
                <i class="bi bi-x-circle-fill mt-1"></i>
                <div>
                    <strong>Rejection Reason:</strong><br>
                    <%= student.rejectionReason %>
                </div>
            </div>
            <% } %>

            <% if (student.status === 'approved') { %>
            <div class="alert alert-success d-flex gap-2 align-items-start mb-4">
                <i class="bi bi-check-circle-fill mt-1"></i>
                <div>
                    <strong>Approved</strong> — Roll Number: <code class="fs-5"><%= student.rollNumber %></code>
                    &nbsp;|&nbsp; Credentials emailed: <%= student.emailNotified ? '✅ Yes' : '❌ No' %>
                </div>
            </div>
            <% } %>

            <div class="row g-4">
                <!-- Personal Info -->
                <div class="col-lg-6">
                    <div class="detail-section">
                        <div class="detail-section-header">
                            <i class="bi bi-person-fill"></i>
                            <h5>Personal Information</h5>
                        </div>
                        <div class="detail-body">
                            <div class="detail-row">
                                <div class="detail-label">Full Name</div>
                                <div class="detail-value"><%= student.fullName %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Date of Birth</div>
                                <div class="detail-value">
                                    <%= new Date(student.dob).toLocaleDateString('en-IN', {
                                        day:'2-digit', month:'long', year:'numeric'
                                    }) %>
                                </div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Gender</div>
                                <div class="detail-value" style="text-transform:capitalize;"><%= student.gender %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Father's Name</div>
                                <div class="detail-value"><%= student.fatherName %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Mother's Name</div>
                                <div class="detail-value"><%= student.motherName %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Aadhar No.</div>
                                <div class="detail-value"><code><%= student.aadhar %></code></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="col-lg-6">
                    <div class="detail-section">
                        <div class="detail-section-header">
                            <i class="bi bi-telephone-fill"></i>
                            <h5>Contact Information</h5>
                        </div>
                        <div class="detail-body">
                            <div class="detail-row">
                                <div class="detail-label">Email</div>
                                <div class="detail-value"><%= student.email %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Phone</div>
                                <div class="detail-value"><%= student.phone %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Address</div>
                                <div class="detail-value"><%= student.address %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">City</div>
                                <div class="detail-value"><%= student.city %></div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Pincode</div>
                                <div class="detail-value"><%= student.pincode %></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Academic Info -->
                <div class="col-12">
                    <div class="detail-section">
                        <div class="detail-section-header">
                            <i class="bi bi-book-fill"></i>
                            <h5>Academic Information</h5>
                        </div>
                        <div class="detail-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-row">
                                        <div class="detail-label">Branch</div>
                                        <div class="detail-value"><%= student.branch %></div>
                                    </div>
                                    <div class="detail-row">
                                        <div class="detail-label">Semester / Year</div>
                                        <div class="detail-value"><%= student.semesterYear %></div>
                                    </div>
                                    <div class="detail-row">
                                        <div class="detail-label">JEE Score</div>
                                        <div class="detail-value"><%= student.jeeScore || '—' %></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-row">
                                        <div class="detail-label">Board (12th)</div>
                                        <div class="detail-value"><%= student.board12 %></div>
                                    </div>
                                    <div class="detail-row">
                                        <div class="detail-label">12th Roll No.</div>
                                        <div class="detail-value"><%= student.roll12 %></div>
                                    </div>
                                    <div class="detail-row">
                                        <div class="detail-label">12th %</div>
                                        <div class="detail-value"><%= student.grade12 %>%</div>
                                    </div>
                                    <div class="detail-row">
                                        <div class="detail-label">10th %</div>
                                        <div class="detail-value"><%= student.grade10 %>%</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-check-circle-fill me-2"></i>Approve Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="approveForm" method="POST" onsubmit="handleApproveSubmit(this)">
                <input type="hidden" name="returnUrl" value="/master/student/<%= student._id %>">
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">
                        Approve admission application for <strong id="approveStudentName" class="text-dark"></strong>?
                    </p>
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">Branch:</span>
                            <span class="fw-600 text-dark" id="approveStudentBranch"></span>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">Student Email:</span>
                            <span class="fw-600 text-dark" id="approveStudentEmail"></span>
                        </div>
                    </div>
                    <div class="alert alert-info py-2 px-3 small mb-0 d-flex gap-2 align-items-center">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span>A unique Roll Number will be generated and login credentials will be emailed to the student.</span>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="confirmApproveBtn" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i> Confirm &amp; Approve
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Reject Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectForm" method="POST">
                <input type="hidden" name="returnUrl" value="/master/student/<%= student._id %>">
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">Rejecting: <strong id="rejectStudentName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label" for="rejectionReason">Reason for Rejection</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason"
                                  rows="4" placeholder="Provide a reason..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i> Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
function openApproveModal(id, name, branch, email) {
    document.getElementById('approveForm').action = '/master/student/' + id + '/approve';
    document.getElementById('approveStudentName').textContent = name;
    document.getElementById('approveStudentBranch').textContent = branch || '—';
    document.getElementById('approveStudentEmail').textContent = email || '—';
    new bootstrap.Modal(document.getElementById('approveModal')).show();
}

function handleApproveSubmit(form) {
    const btn = document.getElementById('confirmApproveBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Approving...';
}

function openRejectModal(studentId, studentName) {
    document.getElementById('rejectForm').action = `/master/student/${studentId}/reject`;
    document.getElementById('rejectStudentName').textContent = studentName;
    new bootstrap.Modal(document.getElementById('rejectModal')).show();
}
</script>
