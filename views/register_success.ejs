<%- include('partials/head', { pageTitle: 'Application Submitted' }) %>

<div class="success-page">
    <div class="success-card">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h2 style="color: var(--primary); margin-bottom: .5rem;">Application Submitted!</h2>
        <p class="text-muted" style="font-size: 1rem; line-height: 1.7;">
            Thank you for applying. Your registration has been received successfully
            and is currently <strong>awaiting review</strong> by the administration.
        </p>

        <div class="alert alert-info text-start mt-3" style="font-size:.875rem;">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>What happens next?</strong>
            <ul class="mt-2 mb-0 ps-3">
                <li>Your application will be reviewed by the Master Admin.</li>
                <li>If approved, your login credentials (Roll Number &amp; Password) will be sent to your registered email address.</li>
                <li>You will then be able to log in to the Student Portal.</li>
                <li>If your application is rejected, you will be notified with a reason.</li>
            </ul>
        </div>

        <div class="d-flex gap-3 justify-content-center mt-4 flex-wrap">
            <a href="/" class="btn btn-outline-secondary">
                <i class="bi bi-house me-1"></i> Homepage
            </a>
            <a href="/student/login" class="btn btn-primary" style="background:var(--primary); border-color:var(--primary);">
                <i class="bi bi-box-arrow-in-right me-1"></i> Student Login
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
