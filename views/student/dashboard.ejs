<%- include('../partials/head', { pageTitle: 'My Dashboard' }) %>

<div class="layout-wrapper">
    <%- include('../partials/student_sidebar', { activePage: 'dashboard', student }) %>

    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">
            <h4><i class="bi bi-grid-1x2-fill me-2 text-primary"></i>My Dashboard</h4>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    <i class="bi bi-person-circle text-primary"></i>
                    <%= student.rollNumber %>
                </span>
                <form action="/student/logout" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <div class="page-content">
            <%- include('../partials/flash_messages') %>

            <!-- Welcome Card -->
            <div class="welcome-card">
                <div class="row align-items-center">
                    <div class="col">
                        <p style="opacity:.75; font-size:.85rem; margin-bottom:.35rem;">
                            <%= new Date().toLocaleDateString('en-IN', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %>
                        </p>
                        <h2>Welcome back, <%= student.fullName.split(' ')[0] %>! 👋</h2>
                        <p>Here's a summary of your academic profile.</p>
                        <div class="welcome-badge">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Application Approved
                        </div>
                    </div>
                    <div class="col-auto d-none d-md-block">
                        <i class="bi bi-mortarboard-fill" style="font-size:5rem; opacity:.2;"></i>
                    </div>
                </div>
            </div>

            <!-- Info Cards -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card blue">
                        <div class="stat-icon"><i class="bi bi-person-badge-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value" style="font-size:1.1rem;"><%= student.rollNumber %></div>
                            <div class="stat-label">Roll Number</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card green">
                        <div class="stat-icon"><i class="bi bi-cpu-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value" style="font-size:1.4rem;"><%= student.branch %></div>
                            <div class="stat-label">Branch</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card yellow">
                        <div class="stat-icon"><i class="bi bi-calendar3-week-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value" style="font-size:1rem;"><%= student.semesterYear %></div>
                            <div class="stat-label">Semester / Year</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card blue">
                        <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="stat-info">
                            <div class="stat-value" style="font-size:1.1rem; color:#16a34a;">Active</div>
                            <div class="stat-label">Account Status</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="data-card">
                <div class="data-card-header">
                    <h5><i class="bi bi-grid me-2"></i>Quick Access</h5>
                </div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <a href="/student/profile" class="text-decoration-none">
                                <div class="p-3 rounded-3 text-center border border-2" style="border-color:#dbeafe!important; background:#eff6ff; transition:all .2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                                    <i class="bi bi-person-circle" style="font-size:2rem; color:var(--accent);"></i>
                                    <p class="mt-2 mb-0 fw-600 text-primary">My Profile</p>
                                    <p class="small text-muted mb-0">View all details</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-4">
                            <a href="/student/results" class="text-decoration-none">
                                <div class="p-3 rounded-3 text-center border border-2" style="border-color:#d1fae5!important; background:#ecfdf5; transition:all .2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                                    <i class="bi bi-bar-chart-line-fill" style="font-size:2rem; color:#10b981;"></i>
                                    <p class="mt-2 mb-0 fw-600 text-success">Results</p>
                                    <p class="small text-muted mb-0">Coming Soon</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-4">
                            <a href="/student/change-password" class="text-decoration-none">
                                <div class="p-3 rounded-3 text-center border border-2" style="border-color:#fef3c7!important; background:#fffbeb; transition:all .2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                                    <i class="bi bi-key-fill" style="font-size:2rem; color:#d97706;"></i>
                                    <p class="mt-2 mb-0 fw-600 text-warning">Change Password</p>
                                    <p class="small text-muted mb-0">Update your password</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </div>
</div>
