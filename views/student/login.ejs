<%- include('../partials/head', { pageTitle: 'Student Login' }) %>

<div class="auth-page">
    <!-- Left branding panel -->
    <div class="auth-left">
        <div class="brand-logo"><i class="bi bi-mortarboard-fill"></i></div>
        <h1>IGEC Student Portal</h1>
        <p>Access your academic dashboard &mdash; Indira Gandhi Engineering College, Sagar.</p>
        <div class="auth-features">
            <div class="auth-feature-item">
                <i class="bi bi-person-badge"></i>
                <span>View your academic profile</span>
            </div>
            <div class="auth-feature-item">
                <i class="bi bi-bar-chart-line"></i>
                <span>Check your results (coming soon)</span>
            </div>
            <div class="auth-feature-item">
                <i class="bi bi-shield-check"></i>
                <span>Secure session-based login</span>
            </div>
            <div class="auth-feature-item">
                <i class="bi bi-envelope-at"></i>
                <span>Credentials sent via email on approval</span>
            </div>
        </div>
    </div>

    <!-- Right login form -->
    <div class="auth-right">
        <div class="auth-card">
            <div class="card-header-text">
                <div style="font-size:2.5rem; color:var(--primary); margin-bottom:.5rem;">
                    <i class="bi bi-person-circle"></i>
                </div>
                <h2>Student Login</h2>
                <p>Enter your roll number and password to continue.</p>
            </div>

            <%- include('../partials/flash_messages') %>

            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <% errors.forEach(err => { %><div><%= err %></div><% }) %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <form action="/student/login" method="POST" id="studentLoginForm">
                <div class="mb-3">
                    <label class="form-label" for="rollNumber">Roll Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                         <input type="text" class="form-control" id="rollNumber"
                                name="rollNumber"
                                placeholder="e.g. 0601IT261066"
                                required autofocus>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="studentPassword">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control" id="studentPassword"
                               name="password" placeholder="Enter your password" required>
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="togglePassword('studentPassword','togglePwdIcon')">
                            <i class="bi bi-eye" id="togglePwdIcon"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn-primary-custom btn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login to Dashboard
                </button>
            </form>

            <div class="text-center mt-4">
                <p class="text-muted small mb-1">Not registered yet?</p>
                <a href="/register" class="text-primary fw-600">
                    <i class="bi bi-pencil-square"></i> Apply for Admission
                </a>
            </div>
            <div class="text-center mt-3">
                <a href="/master/login" class="text-muted small">
                    <i class="bi bi-shield-lock"></i> Master Admin Login
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
}
</script>

<%- include('../partials/footer') %>
